# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore only Bundler's root-level vendor directory. The theme's tracked
# Sass dependencies live under _sass/vendor and are required to build Pages.
/vendor/
.bundle/
